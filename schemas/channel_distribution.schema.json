{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScribeKey Channel Distribution Manifest",
  "description": "Deterministic distribution manifest consumed by Android",
  "type": "object",
  "required": ["schemaVersion", "channel", "sequence", "issuedAt", "releaseId", "compatibility", "catalogs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "channel": {
      "type": "string",
      "enum": ["qa", "stable"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}(\\.[0-9]+)?$"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "minAndroidApiLevel",
        "minAppVersionCode",
        "catalogsSchemaVersion",
        "supportedRuntimeFamilies",
        "supportedConfigFamilies"
      ],
      "additionalProperties": false,
      "properties": {
        "minAndroidApiLevel": {
          "type": "integer",
          "minimum": 21
        },
        "minAppVersionCode": {
          "type": "integer",
          "minimum": 1
        },
        "catalogsSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "supportedRuntimeFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["sherpa-onnx", "gguf", "pyannote"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supportedConfigFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "speech-model-catalog",
              "cleanup-model-catalog",
              "speaker-diarization-manifest"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "gitCommit": {
      "type": "string"
    },
    "catalogs": {
      "type": "object",
      "required": ["speech", "diarization", "cleanup"],
      "additionalProperties": false,
      "properties": {
        "speech": { "$ref": "#/$defs/distributionCatalogRef" },
        "diarization": { "$ref": "#/$defs/distributionCatalogRef" },
        "cleanup": { "$ref": "#/$defs/distributionCatalogRef" }
      }
    },
    "recoveryAssets": {
      "type": "object"
    }
  },
  "$defs": {
    "distributionCatalogRef": {
      "type": "object",
      "required": ["filename", "path", "sha256", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string" },
        "path": { "type": "string", "pattern": "^\\.\\./releases/.+" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
